{
  "name": "@nexis/design",
  "version": "0.2.0",
  "packageManager": "pnpm@11.22.0",
  "description": "The design system for Nexis-family Tauri v2 webview apps (React 19 + Tailwind v4): OKLCH tokens, 22 themes, a runtime theme engine, ~70 components, seven app templates, borderless window chrome and the bespoke cursor set.",
  "keywords": [
    "tauri",
    "react",
    "tailwindcss",
    "design-system",
    "oklch",
    "shadcn",
    "radix",
    "nexis"
  ],
  "license": "Apache-2.0",
  "author": "Ryan Wetzstein",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rwetz/nexis-design.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme/index.ts",
    "./icon": "./src/icon/icon.tsx",
    "./ui/*": "./src/components/ui/*.tsx",
    "./tokens": "./src/styles/tokens.ts",
    "./styles/globals.css": "./src/styles/globals.css",
    "./styles/globals.ide.css": "./src/styles/globals.ide.css",
    "./styles/fonts.css": "./src/styles/fonts.css",
    "./styles/code-highlight.css": "./src/styles/code-highlight.css",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "nexis-design-assets": "./bin/sync-assets.mjs"
  },
  "files": [
    "src",
    "assets",
    "bin",
    "docs",
    "templates",
    "scripts/new-app.sh",
    "AGENTS.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "screenshots": "node scripts/screenshots.mjs",
    "new-app": "bash scripts/new-app.sh"
  },
  "peerDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-os": "~2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "motion": "^13.4.0",
    "radix-ui": "^1.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.12.3",
    "shadcn": "^4.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.2.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-os": "~2.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jsdom": "^30.0.1",
    "motion": "^13.4.0",
    "playwright-core": "1.56.1",
    "radix-ui": "^1.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.12.3",
    "shadcn": "^4.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.7"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    },
    "@tauri-apps/plugin-os": {
      "optional": true
    }
  }
}
