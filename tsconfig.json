{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": [
      "vite/client",
      "@testing-library/jest-dom",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@nexis/design": [
        "src/index.ts"
      ],
      "@nexis/design/ui/*": [
        "src/components/ui/*"
      ],
      "@nexis/design/icon": [
        "src/icon/icon.tsx"
      ],
      "@nexis/design/theme": [
        "src/theme/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "gallery",
    "templates",
    "test",
    "vite.config.ts"
  ]
}